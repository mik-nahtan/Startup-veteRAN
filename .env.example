# Node.js 24+ is required. Copy this file to .env for local configuration.
PORT=3001
# Keep application records outside version control.
DATABASE_PATH=./data/veteran.sqlite
# Set a long, random private token to enable /organizer and admin exports.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
# Optional public project contact.
PUBLIC_CONTACT_EMAIL=
# Only set both after the receiving partner approves its hosted donation page.
# Never put a payment secret or a personal payment account here.
DONATION_URL=
DONATION_PARTNER_NAME=
